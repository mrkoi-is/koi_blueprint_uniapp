{
  "name": "koi_blueprint_uniapp",
  "version": "0.1.0",
  "private": true,
  "description": "AI-agent-oriented uni-app blueprint for H5 and WeChat Mini Programs",
  "type": "module",
  "engines": {
    "node": ">=22.13 <25"
  },
  "author": "mrkoi",
  "keywords": [
    "uni-app",
    "vue3",
    "typescript",
    "vite",
    "pinia",
    "wechat-miniprogram",
    "h5",
    "blueprint",
    "template",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrkoi-is/koi_blueprint_uniapp.git"
  },
  "homepage": "https://github.com/mrkoi-is/koi_blueprint_uniapp#readme",
  "bugs": "https://github.com/mrkoi-is/koi_blueprint_uniapp/issues",
  "scripts": {
    "doctor": "node skeleton/scripts/doctor.mjs",
    "check:mcp": "node scripts/check-mcp-config.mjs",
    "check:weixin-mcp": "node scripts/check-weixin-mcp.mjs",
    "check:audit": "node scripts/check-open-source-audit.mjs",
    "check:generator": "node scripts/check-generator-contract.mjs",
    "create": "node scripts/apply-skeleton.mjs",
    "validate": "node scripts/validate-blueprint.mjs",
    "validate:blueprint": "node scripts/validate-blueprint.mjs --blueprint-only",
    "validate:skeleton": "npm --prefix skeleton run validate",
    "upgrade": "node scripts/upgrade-blueprint.mjs",
    "check:upgrade": "node scripts/check-upgrade-contract.mjs",
    "test:smoke:mp-weixin": "node tools/weixin-smoke/run.mjs"
  },
  "license": "MIT"
}
