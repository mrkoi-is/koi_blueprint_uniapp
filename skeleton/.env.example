# Public build-time configuration. VITE_* values are bundled into the client.
# Keep credentials and private keys on a backend.
VITE_API_BASE_URL_LOCAL=https://dev-api.example.com
VITE_API_BASE_URL_STAGING=https://staging-api.example.com
VITE_API_BASE_URL_PRODUCTION=https://api.example.com
VITE_REQUEST_TIMEOUT_MS=10000
