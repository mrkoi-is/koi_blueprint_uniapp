{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{PROJECT_TITLE}} — uni-app application",
  "engines": {
    "node": ">=22.13 <25"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "npm run dev:mp-weixin",
    "dev:h5": "uni --host 127.0.0.1 --port 5173",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build": "npm run build:mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:targets": "npm run build:h5 && npm run build:mp-weixin",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:env": "node scripts/check-env-contract.mjs",
    "check:dcloud-cohort": "node scripts/check-dcloud-cohort.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:weixin-ai-profile": "node scripts/check-weixin-ai-profile.mjs",
    "check:mp-budget": "node scripts/check-mp-package-budget.mjs",
    "scaffold:feature": "node scripts/scaffold-feature.mjs",
    "validate:fast": "npm run typecheck && npm run lint && npm run check:dcloud-cohort && npm run check:env && npm run check:architecture && npm run check:routes && npm run check:weixin-ai-profile && npm run test",
    "validate": "npm run format:check && npm run validate:fast && npm run test:coverage && npm run build:targets && npm run check:mp-budget"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5010520260709002",
    "@dcloudio/uni-components": "3.0.0-5010520260709002",
    "@dcloudio/uni-h5": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5010520260709002",
    "pinia": "2.1.7",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5010520260709002",
    "@dcloudio/uni-stacktracey": "3.0.0-5010520260709002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5010520260709002",
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/compiler-sfc": "3.4.21",
    "@vue/runtime-core": "3.4.21",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "rollup": "4.14.3",
    "sass": "1.89.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "5.2.8",
    "vitest": "3.2.4",
    "vue-eslint-parser": "10.3.0",
    "vue-tsc": "3.3.8"
  }
}
